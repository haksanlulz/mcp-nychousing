{
  "name": "@haksanlulz/mcp-nychousing",
  "version": "1.1.0",
  "description": "MCP server over NYC Open Data (Socrata/SODA) for NYC housing data: HPD violations, complaints, building ownership, landlord portfolios (reverse ownership lookup by name), HPD litigation, and marshal evictions, built for tenant organizers, housing-court legal aid, and Right-to-Counsel orgs.",
  "type": "module",
  "license": "MIT",
  "author": "Abishai James",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haksanlulz/mcp-nychousing.git"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build && npm run typecheck && npm test",
    "smoke": "tsx smoke.ts",
    "start": "tsx index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:pack": "node scripts/pack-probe.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "nyc-open-data",
    "socrata",
    "soda",
    "hpd",
    "housing",
    "tenant-rights",
    "evictions",
    "legal-aid",
    "civic-data"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "main": "dist/index.js",
  "bin": {
    "mcp-nychousing": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
